# Required only for an explicitly enabled live Cloud API transition spike.
VESTAQUEST_SPIKE_DIGITAL_CLOUD_TOKEN=
VESTAQUEST_SPIKE_PHYSICAL_CLOUD_TOKEN=

# Dry-run is unconditional unless --live is passed. See the runbook for acknowledgement values.
VESTAQUEST_ENABLE_LIVE_WRITES=

# Cloud documentation warns against more than one message every 15 seconds.
VESTAQUEST_MINIMUM_WRITE_INTERVAL_MS=16000

# Physical mode requires an additional acknowledgement documented in the runbook.
VESTAQUEST_ENABLE_PHYSICAL_WRITES=

# Optional private-development override. Defaults to ignored .vestaquest/sessions.sqlite.
VESTAQUEST_DATABASE_PATH=
